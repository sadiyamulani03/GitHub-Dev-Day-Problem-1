# ---------------------------------------------------------------------------
# Practice-Day Outfit Caller -- example environment file (CHECK 8)
#
# Copy this file to `.env` and adjust. `.env` is git-ignored and must never be
# committed. Every value below is a non-secret default: this application talks
# to the Open-Meteo public API, which requires no API key, and it stores opaque
# server-side session tokens (no signing secret is needed).
# ---------------------------------------------------------------------------

# HTTP port the server listens on.
PORT=3000

# SQLite database file. Use an absolute path or a path relative to the repo root.
# Tests override this with an in-memory database and never touch your local file.
DATABASE_PATH=./data/app.db

# "development" or "production". In production the session cookie is marked Secure.
NODE_ENV=development

# Lifetime of a coach's login session, in hours.
SESSION_TTL_HOURS=168

# Length of a practice session in minutes; used to pick the forecast window
# that starts at the team's practice time.
PRACTICE_DURATION_MINUTES=90

# Upstream weather + geocoding providers (public, keyless).
# Override only if you need to point at a proxy or a mock server.
WEATHER_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
UPSTREAM_TIMEOUT_MS=8000

# Set to 1 to enable the live Open-Meteo integration test
# (`npm run test:live`). It is off by default so the unit suite stays offline.
RUN_LIVE_WEATHER=0
